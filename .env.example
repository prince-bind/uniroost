# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. For local dev with docker-compose, this
# matches the service defined in docker-compose.yml.
DATABASE_URL=''

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=''
NEXTAUTH_URL=''

# Cloudinary (image uploads for property photos / owner ID proofs).
# Create a free account at https://cloudinary.com if you don't have one.
CLOUDINARY_CLOUD_NAME=''
CLOUDINARY_API_KEY=''
CLOUDINARY_API_SECRET=''

NODE_ENV='development'
